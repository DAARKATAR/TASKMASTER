{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node -e \"console.log('Server ready for Vercel')\"",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/ws/:path*",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/api"
    }
  ]
}